# Copy this file to .env and fill in your own values.
# Get these from your Supabase project: Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is a real secret with full database access
# (bypasses RLS) — never commit it, never share it, never paste it into
# chat. .env is already gitignored below.

SUPABASE_URL=https://kaczlnadnehihgnzylkz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Read-scope Hugging Face token. Required: the Whisper checkpoint the
# checker loads is a private repo, so without this the service starts and
# then fails on the first transcription with a 401 from the Hub.
HF_TOKEN=

# Optional. Overrides the Whisper checkpoint in recitation_checker.py —
# set it to roll back to tarteel-ai/whisper-base-ar-quran, or forward to a
# later fine-tune, without a code change. Leave blank to use the default.
WHISPER_MODEL_ID=

# Which word-accuracy method the auto-checker uses. "transcribe" (the
# default) has Whisper transcribe freely and diffs the text against the
# expected words. "align" matches the audio against the expected
# phonemes instead, so a word can only be flagged when its own sounds
# are missing — see alignment_checker.py. Leave blank for transcribe.
WORD_CHECK_MODE=
